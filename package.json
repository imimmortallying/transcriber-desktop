{
  "name": "local-asr-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Локальный Electron-прототип для распознавания речи через GigaAM.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/runtime/resolveCurrentClientInstallationRoot.js && node --check src/runtime/resolveRuntime.js && node --check src/recognition/runRecognition.js && node --check src/renderer/renderer.js && node --check scripts/buildRuntimeArchive.js && node --check scripts/buildClientArtifact.js",
    "test:runtime": "node --test test/runtime/resolveRuntime.test.js",
    "test:packaging": "node --test test/packaging/fullSetup.test.js",
    "prepare:runtime": "node scripts/buildRuntimeArchive.js",
    "dist:client": "electron-builder --win --x64 --dir && node scripts/buildClientArtifact.js",
    "test:client-artifact": "npm run dist:client && node --test test/packaging/clientArtifact.test.js",
    "dist:win": "npm run prepare:runtime && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "ru.sber.local-asr",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": false,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@electron/asar": "3.2.18",
    "electron": "^41.7.1",
    "electron-builder": "26.0.12",
    "7zip-bin": "5.2.0"
  }
}
