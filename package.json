{
  "name": "local-asr-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Локальный Electron-прототип для распознавания речи через GigaAM.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/runtime/resolveRuntime.js && node --check src/recognition/runRecognition.js && node --check src/renderer/renderer.js",
    "test:runtime": "node --test test/runtime/resolveRuntime.test.js",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "ru.sber.local-asr",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python"
      },
      {
        "from": "pipeline/asr_pipeline",
        "to": "pipeline/asr_pipeline"
      },
      {
        "from": "pipeline/config.app.example.json",
        "to": "pipeline/config.json"
      },
      {
        "from": "runtime-manifest.json",
        "to": "runtime-manifest.json"
      },
      {
        "from": "resources/bin/ffmpeg",
        "to": "bin/ffmpeg"
      },
      {
        "from": "resources/models/gigaam",
        "to": "models/gigaam"
      }
    ]
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "26.0.12"
  }
}
